DATABASE_URL="postgresql://hakmar:hakmar_dev_only@localhost:5433/hakmar?schema=public"

# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace_me_with_openssl_rand_hex_32_output"
JWT_ACCESS_EXPIRES_IN="20m"
JWT_REFRESH_EXPIRES_IN="7d"

REDIS_URL="redis://localhost:6380"

# The web dev server. Must match what Vite actually serves — apps/web's
# vite.config.ts pins 5174 and refuses to drift, so these two cannot fall out
# of step without saying so.
WEB_ORIGIN="http://localhost:5174"

# 3001 rather than 3000. Nothing is wrong with 3000 except that every other
# Node app on the machine wants it too; this way a second project can run
# beside this one. A deployment sets its own.
PORT="3001"

SEED_ADMIN_USERNAME="superadmin"
# The seed creates the first superadmin with these. The README quotes this
# exact password, so the two must not drift apart.
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Set to the number of reverse-proxy hops in front of this app (e.g. "1" for
# a single nginx/ALB) once deployed behind one. Leave unset locally.
# TRUST_PROXY="1"

# Set to "true" wherever the app is served over HTTPS so the refresh cookie
# carries the Secure attribute. Leave unset for plain-HTTP local development,
# where a Secure cookie would be silently dropped by the browser.
# COOKIE_SECURE="true"

# Three per-IP limits, all sharing one window (LOGIN_RATE_TTL_MS). The
# defaults suit the public internet; raise them where many users share one
# egress IP, e.g. an office behind a single NAT. The e2e suite raises the
# first two because every request in it originates from the same address.
#
#   LOGIN_RATE_LIMIT     sign-in attempts        (default 5 / 60s)
#   SESSION_RATE_LIMIT   refresh + logout        (default 20 / 60s)
#   FORECAST_RATE_LIMIT  POST /spatial-forecast/run (default 10 / 60s) — the
#                        one expensive route that cannot be cached, so it
#                        needs a limit rather than the loose global one.
#
# LOGIN_RATE_LIMIT="5"
# SESSION_RATE_LIMIT="20"
# FORECAST_RATE_LIMIT="10"
# LOGIN_RATE_TTL_MS="60000"
