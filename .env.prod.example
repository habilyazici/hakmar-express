# Copy to .env.prod and fill in. Every variable marked required below has no
# default: compose refuses to start rather than quietly running with one, and
# the API validates its own environment again at boot.

# --- required -------------------------------------------------------------

POSTGRES_USER=hakmar
POSTGRES_DB=hakmar
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# At least 32 characters. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=

# Where the app is actually reached, scheme included — https://reports.example.com
# The API compares this against the Origin header, so a value that does not
# match what the browser sends turns every request into a CORS failure.
PUBLIC_ORIGIN=

# The first superadmin, created by `pnpm --filter api exec prisma db seed`.
# Must satisfy the same rule the API enforces on every password: 12-128
# characters with a lowercase letter, an uppercase letter and a digit.
SEED_ADMIN_PASSWORD=

# --- optional -------------------------------------------------------------

# Host port the proxy publishes. Put a TLS terminator in front of it.
PUBLIC_PORT=8080

# Leave true wherever the app is served over HTTPS, which should be
# everywhere. Setting it false drops the Secure attribute from the refresh
# cookie, and that cookie is a seven-day credential.
COOKIE_SECURE=true

SEED_ADMIN_USERNAME=superadmin
JWT_ACCESS_EXPIRES_IN=20m
JWT_REFRESH_EXPIRES_IN=7d

# Per-IP rate limits, all counted over RATE_LIMIT_TTL_MS. Raise them where
# many users share one egress address — an office behind a single NAT — or
# the limit that protects a public deployment is the one that locks out a
# floor of analysts. GLOBAL_RATE_LIMIT is the one ordinary browsing hits:
# Grafikler alone fetches six panels on one page load.
# GLOBAL_RATE_LIMIT=60
# LOGIN_RATE_LIMIT=5
# SESSION_RATE_LIMIT=20
# FORECAST_RATE_LIMIT=10
# RATE_LIMIT_TTL_MS=60000

# Where the backup container writes its dumps. A host path by default, so
# they survive `docker compose down -v` — which is the accident they exist
# for. Point it at storage that is replicated elsewhere; a backup on the same
# disk as the database is not a backup.
BACKUP_PATH=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
