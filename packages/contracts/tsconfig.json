{
  "compilerOptions": {
    // CommonJS on purpose. The API is CJS and the web is ESM through Vite;
    // CJS is the one output both consume without a dual-package build, and
    // this package is small enough that the tree-shaking argument for ESM
    // does not apply.
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
